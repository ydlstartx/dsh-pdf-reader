{
  "name": "dsh-pdf-reader",
  "version": "0.1.0-beta.5",
  "description": "AI-powered PDF reader for DeepSeek Harness with annotations, multi-PDF workflows, mixed image-text evidence, and on-demand OCR.",
  "keywords": [
    "deepseek-harness",
    "pdf",
    "pdf-reader",
    "annotation",
    "ocr",
    "ai"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.yml",
    "THIRD_PARTY_NOTICES.md",
    "LICENSES"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --test test/*.test.ts",
    "verify": "tsc --noEmit && pnpm test",
    "check": "pnpm verify && pnpm build",
    "prepack": "pnpm build",
    "watch": "tsdown --watch"
  },
  "engines": {
    "node": ">=24.9.0",
    "pnpm": ">=11.28.5",
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "packageManager": "pnpm@11.28.5",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/dsh-agent-default-model": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@types/node": "~22.19.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "0.4.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108"
  }
}
